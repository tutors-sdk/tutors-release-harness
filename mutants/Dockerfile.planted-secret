# The "secret-env" mutant: the production image plus one environment variable whose name says it holds a secret.
#
#   docker build -f mutants/Dockerfile.planted-secret --build-arg BASE=tutors/reader:16.2.0 \
#     -t tutors-harness/mutant-secret-env mutants
#
# What the image-hardening policy check (src/compare/policy.ts) must find on b: an environment variable in the image
# config whose name says it is a secret and which has a value. The value is a fixed, harmless string, not a credential;
# the check matches names and value shapes and never stores or prints a value. Nothing in the app reads the variable.
ARG BASE
FROM ${BASE}
ENV HARNESS_PLANTED_API_TOKEN="planted-by-the-harness-not-a-credential"
