{
  "$comment": "What the harness's workflows accept from outside and publish, machine-readable. tests/contract.test.ts fails when this and .github/workflows disagree.",
  "contractVersion": "1.0.0",
  "repositoryDispatch": {
    "release-candidate": {
      "workflow": "release.yml",
      "clientPayload": {
        "production": { "required": true, "meaning": "Production tag (side a), e.g. 16.2.0" },
        "candidate": { "required": true, "meaning": "Candidate tag (side b), e.g. 16.3.0-rc.4" },
        "claims_url": { "required": false, "meaning": "URL the runner can GET without credentials for the release's claims.yaml" },
        "runs": { "required": false, "meaning": "Journey repetitions per side; default 3" },
        "migrations_a": { "required": false, "meaning": "Monorepo git ref for production's migrations; default v<production>" },
        "migrations_b": { "required": false, "meaning": "Monorepo git ref for the candidate's migrations; default v<candidate>" }
      }
    },
    "deployed": {
      "workflow": "post-deploy.yml",
      "clientPayload": {}
    }
  },
  "repositoryVariables": {
    "HARNESS_IMAGE_PREFIX": { "default": "tutors", "usedBy": ["ci.yml", "nightly-noise.yml", "release.yml", "weekly-mutants.yml"] },
    "HARNESS_PRODUCTION_TAG": { "default": "main", "usedBy": ["ci.yml", "nightly-noise.yml", "weekly-mutants.yml"] },
    "HARNESS_PRODUCTION_URLS": {
      "default": "reader=https://tutors.dev,catalogue=https://catalogue.tutors.dev,live=https://live.tutors.dev",
      "usedBy": ["post-deploy.yml"]
    }
  },
  "artifacts": {
    "release-report": { "workflow": "release.yml", "retentionDays": 30 },
    "migration-report": { "workflow": "release.yml", "retentionDays": 30 },
    "upgrade-report": { "workflow": "release.yml", "retentionDays": 30 },
    "post-deploy-report": { "workflow": "post-deploy.yml", "retentionDays": 14 },
    "noise-status": { "workflow": "nightly-noise.yml", "retentionDays": 8 },
    "noise-report": { "workflow": "nightly-noise.yml", "retentionDays": 8 },
    "mutant-reports": { "workflow": "weekly-mutants.yml", "retentionDays": 14 },
    "harness-ci": { "workflow": "ci.yml", "retentionDays": 7 }
  },
  "forbiddenPermissions": ["pull-requests", "checks", "statuses", "deployments"]
}
